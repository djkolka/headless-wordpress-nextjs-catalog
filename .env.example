# WordPress REST base URL, without a trailing slash.
WORDPRESS_API_URL=https://wordpress.example.test/wp-json/catalog/v1

# Server-only WordPress Application Password credentials used for draft preview.
WORDPRESS_APPLICATION_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Canonical public URL of the Next.js application.
NEXT_PUBLIC_SITE_URL=https://catalog.example.test

# Independent, high-entropy values. Never prefix these with NEXT_PUBLIC_.
PREVIEW_SECRET=
REVALIDATION_SECRET=
