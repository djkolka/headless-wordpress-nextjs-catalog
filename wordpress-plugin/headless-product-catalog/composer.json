{
  "name": "portfolio/headless-product-catalog",
  "description": "Normalized WordPress REST API for a headless product catalog",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": { "php": ">=8.1" },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "yoast/phpunit-polyfills": "^2.0.5"
  },
  "scripts": {
    "test": "phpunit --fail-on-empty-test-suite",
    "lint": "phpcs --standard=phpcs.xml.dist"
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }, "sort-packages": true }
}
